# DIADesigner-AX / CODESYS working files (per-user, regenerated)
*.opt
*.~u
*.precompilecache
*.compileinfo
*.bootinfo
*.bootinfo_guids
*.tgs
*.Device.Application.xml

# Only PilaJednosuportowaSoftmotion.project is part of this repo - the other
